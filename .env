# Database Configuration
DATABASE_URL=postgres://oidc_user:password@localhost:5433/oidc_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_BASE_URL=http://localhost:8080

# JWT Configuration
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900  # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=2592000  # 30 days
JWT_PRIVATE_KEY_PATH=./keys/private_key.pem
JWT_PUBLIC_KEY_PATH=./keys/public_key.pem

# Session Configuration (NIST 800-63B AAL2)
SESSION_IDLE_TIMEOUT_SECONDS=900  # 15 minutes
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200  # 12 hours
SESSION_MAX_CONCURRENT=5

# Security Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=900  # 15 minutes

# MFA Configuration
MFA_REQUIRED_FOR_ADMIN=true
TOTP_ISSUER=OIDC SSO

# GDPR Configuration
DATA_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# External Services
HIBP_API_ENABLED=true  # HaveIBeenPwned password breach check

# Logging
RUST_LOG=info,auth_server=debug
LOG_FORMAT=json

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_MAX_AGE=3600

# TLS Configuration (Production)
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
